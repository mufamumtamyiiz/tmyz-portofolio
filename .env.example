# Copy this file to .env and set your real values.
# Do NOT commit the real .env to git.

# Resend API key used by the backend to send email notifications.
RESEND_API_KEY="your_resend_api_key_here"

# Base URL used in Accept / Reject links inside the email.
# For local development, use the backend URL or the frontend URL that can serve the action endpoints.
# Example local: http://localhost:3001
# Example Vercel: https://your-app.vercel.app
PUBLIC_BASE_URL="http://localhost:3001"

# Optional Firebase Admin credentials if you want the Accept/Reject links to update Firestore status.
# FIREBASE_PROJECT_ID="your-project-id"
# FIREBASE_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
